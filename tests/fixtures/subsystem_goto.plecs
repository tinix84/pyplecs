Plecs {
  Name          "subsystem_goto"
  Version       "4.7"
  CircuitModel  "ContStateSpace"
  StartTime     "0.0"
  TimeSpan      "T_sim"
  Solver        "radau"
  MaxStep       "1e-6"
  InitializationCommands "T_sim = 1e-3;\nVi = 24;\nRo = 6;\n"
  InitialState  "1"
  SystemState   ""
  CodeGenBaseName ""
  Schematic {
    Location      [0, 0; 800, 600]
    ZoomFactor    1
    Component {
      Type          DCVoltageSource
      Name          "V1"
      Show          on
      Position      [100, 100]
      Direction     up
      Flipped       off
      LabelPosition west
      Parameter {
        Variable      "V"
        Value         "Vi"
        Show          off
      }
    }
    Component {
      Type          Resistor
      Name          "R1"
      Show          on
      Position      [300, 100]
      Direction     up
      Flipped       off
      LabelPosition east
      Parameter {
        Variable      "R"
        Value         "Ro"
        Show          off
      }
    }
    Component {
      Type          Voltmeter
      Name          "Vm1"
      Show          on
      Position      [400, 100]
      Direction     up
      Flipped       off
      LabelPosition east
    }
    Component {
      Type          Subsystem
      Name          "Filter"
      Show          on
      Position      [500, 300]
      Direction     up
      Flipped       off
      Frame         [-30, -20; 30, 20]
      LabelPosition [0, 23]
      LabelAlign    up
      SampleTime    "-1"
      CodeGenTarget "Generic"
      MaskIconFrame on
      MaskIconOpaque off
      MaskIconRotates on
      Terminal {
        Type          Input
        Position      [-30, 0]
        Direction     left
      }
      Terminal {
        Type          Output
        Position      [34, 0]
        Direction     right
      }
      Schematic {
        Location      [0, 0; 400, 300]
        ZoomFactor    1
        Component {
          Type          Input
          Name          "In"
          Show          on
          Position      [50, 50]
          Direction     right
          Flipped       off
          Parameter {
            Variable      "Index"
            Value         "1"
            Show          on
          }
          Parameter {
            Variable      "Width"
            Value         "-1"
            Show          off
          }
        }
        Component {
          Type          Gain
          Name          "K"
          Show          on
          Position      [150, 50]
          Direction     right
          Flipped       off
          Parameter {
            Variable      "K"
            Value         "0.5"
            Show          off
          }
          Parameter {
            Variable      "Multiplication"
            Value         "1"
            Show          off
          }
        }
        Component {
          Type          Output
          Name          "Out"
          Show          on
          Position      [250, 50]
          Direction     right
          Flipped       off
          Parameter {
            Variable      "Index"
            Value         "2"
            Show          on
          }
          Parameter {
            Variable      "Width"
            Value         "-1"
            Show          off
          }
        }
        Connection {
          Type          Signal
          SrcComponent  "In"
          SrcTerminal   1
          DstComponent  "K"
          DstTerminal   1
        }
        Connection {
          Type          Signal
          SrcComponent  "K"
          SrcTerminal   2
          DstComponent  "Out"
          DstTerminal   1
        }
      }
    }
    Component {
      Type          Goto
      Name          "Goto1"
      Show          off
      Position      [450, 200]
      Direction     right
      Flipped       off
      Parameter {
        Variable      "Tag"
        Value         "vo"
        Show          off
      }
      Parameter {
        Variable      "Visibility"
        Value         "1"
        Show          off
      }
    }
    Component {
      Type          From
      Name          "From1"
      Show          off
      Position      [450, 300]
      Direction     right
      Flipped       off
      Parameter {
        Variable      "Tag"
        Value         "vo"
        Show          off
      }
      Parameter {
        Variable      "Visibility"
        Value         "1"
        Show          off
      }
    }
    Component {
      Type          Output
      Name          "Out1"
      Show          on
      Position      [650, 300]
      Direction     right
      Flipped       off
      Parameter {
        Variable      "Index"
        Value         "1"
        Show          on
      }
      Parameter {
        Variable      "Width"
        Value         "-1"
        Show          off
      }
    }
    Component {
      Type          FreeText
      Name          "note"
      Show          on
      Position      [100, 500]
      Direction     up
      Flipped       off
      Frame         [-100, -20; 100, 20]
      LabelPosition center
      Parameter {
        Variable      "Text"
        Value         "A note that must not affect the key"
        Show          off
      }
    }
    Connection {
      Type          Wire
      SrcComponent  "V1"
      SrcTerminal   1
      Points        [100, 50]
      Branch {
        DstComponent  "R1"
        DstTerminal   1
      }
      Branch {
        DstComponent  "Vm1"
        DstTerminal   1
      }
    }
    Connection {
      Type          Wire
      SrcComponent  "V1"
      SrcTerminal   2
      Points        [100, 150]
      Branch {
        DstComponent  "R1"
        DstTerminal   2
      }
      Branch {
        DstComponent  "Vm1"
        DstTerminal   2
      }
    }
    Connection {
      Type          Signal
      SrcComponent  "Vm1"
      SrcTerminal   3
      DstComponent  "Goto1"
      DstTerminal   1
    }
    Connection {
      Type          Signal
      SrcComponent  "From1"
      SrcTerminal   1
      DstComponent  "Filter"
      DstTerminal   1
    }
    Connection {
      Type          Signal
      SrcComponent  "Filter"
      SrcTerminal   2
      DstComponent  "Out1"
      DstTerminal   1
    }
  }
}
