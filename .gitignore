# Byte-compiled / optimized / DLL files
# remove __pycache__ for all folders and subfolders
__pycache__/
pyplecs/webgui/__pycache__/
/pyplecs/__pycache__/
/tests/__pycache__/

# other
pyplecs.egg-info/
.pytest_cache/
.venv/

# remove build artifacts
/dist
/build
*.egg-info


/utils/guipropview-x64
/utils/winlister-x64
/utils/depends22_x64
/utils/MacroCreatorPortable/x64/MacroCreator
/utils/MacroCreatorPortable/x86/MacroCreator
/utils/gui-inspect-tool-master
/utils/py_inspect-master

/utils/MacroCreatorPortable
tests/OLD/

utils/

*.old
.idea/
.claude/

docs/articles/diagrams/output/
docs/articles/output/
FORCE_PUSH_PLAN.txt

# Local PLECS sample experiments (canonical samples like simple_buck_prb.plecs
# stay tracked; this rule only affects new untracked .plecs / .plecs.bak / .m files)
data/*.plecs*
data/*.m
data/*.csv

# Build artifacts
site/
/cache/
*.egg-info/

# IDE artifacts
.vscode/.ropeproject/

# Local holding pen for removed files — git history is the real archive
.trash/

# Plans and specs are temporary and disposable (ADR-0004)
docs/superpowers/

# Machine-local config (ADR-0008). Seeded from config/default.example.yml by
# `pyplecs-setup configure-plecs`; holds absolute paths for this machine only.
config/default.yml

# uv-managed environment
.venv/
uv.lock.bak

# Evidence Bundles (ADR-0013): manifests, metrics and summaries are tracked; raw series and overlays are not
tests/evidence/**/raw/
tests/evidence/**/*.svg
tests/evidence/**/spice/
