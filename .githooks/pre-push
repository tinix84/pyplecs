#!/usr/bin/env bash
# Quality gate on push. Wired via `git config core.hooksPath .githooks`.
#
# This is the only gate that can actually block a push — a Claude Code
# PostToolUse hook runs after the push has already happened.
#
# Tools are invoked through `uv run` when uv is available (ADR-0008), because
# bare `pytest` is not on PATH unless .venv happens to be activated, and a
# gate that silently skips its own tests is worse than no gate.

set -e

# Deleting a branch pushes only zero-sha refs. Linting and testing the local
# working tree tells us nothing about a deletion, so skip the gate entirely --
# otherwise removing six merged branches costs six full test runs.
all_deletions=1
saw_ref=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
    [ -z "$local_sha" ] && continue
    saw_ref=1
    case "$local_sha" in
        *[!0]*) all_deletions=0 ;;
    esac
done
if [ "$saw_ref" = 1 ] && [ "$all_deletions" = 1 ]; then
    echo "[pre-push] deletion-only push; skipping checks."
    exit 0
fi

PYTEST_FILES=(
    tests/test_installer.py
    tests/test_entrypoint.py
    tests/test_install_full.py
    tests/test_abc_contract.py
    tests/test_plecs_expert.py
)

if command -v uv >/dev/null 2>&1; then
    RUN=(uv run --extra dev)
else
    RUN=()
    echo "[pre-push] WARNING: uv not found; falling back to whatever is on PATH."
fi

run() {
    if [ ${#RUN[@]} -eq 0 ]; then
        command -v "$1" >/dev/null 2>&1 || { echo "[pre-push] MISSING: $1"; return 127; }
    fi
    "${RUN[@]}" "$@"
}

echo "[pre-push] Checking structural rules (ADR-0004, ADR-0008)..."
python "$(dirname "$0")/check_structure.py"
echo "[pre-push] structural rules passed."

echo "[pre-push] Running ruff..."
run ruff check .
echo "[pre-push] ruff passed."

echo "[pre-push] Running vulture..."
run vulture pyplecs/ tests/ --min-confidence 90
echo "[pre-push] vulture passed."

echo "[pre-push] Running platform-independent tests..."
run pytest -q "${PYTEST_FILES[@]}"
echo "[pre-push] tests passed."

echo "[pre-push] All checks passed."
